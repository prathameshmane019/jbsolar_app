{
  "expo": {
    "name": "JB Solar Agent",
    "slug": "jb-solar-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/jb-solar-app-icon-1024.png",
    "scheme": "jbsolarapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.jbsolar.agent",
      "icon": "./assets/jb-solar-app-icon-1024.png"
    },
    "android": {
      "package": "com.jbsolar.agent",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#07412B",
        "foregroundImage": "./assets/jb-solar-app-icon-1024.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/favicon-512x512.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07412B",
          "image": "./assets/jb-solar-app-icon-1024.png",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow JB Solar Agent to capture installation evidence.",
          "photosPermission": "Allow JB Solar Agent to select installation evidence.",
          "microphonePermission": false
        }
      ],
      "./plugins/with-local-api-http",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fe063bb8-3a19-402b-9cb8-6f3beac2733f"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/fe063bb8-3a19-402b-9cb8-6f3beac2733f",
      "checkAutomatically": "NEVER"
    }
  }
}